rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: anyone can read (leaderboard). You can only write your own,
    // and online wins can only go up by a few at a time.
    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 14
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 200
        && request.resource.data.owins is int && request.resource.data.owins >= 0 && request.resource.data.owins <= 5;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 14
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 200
        && request.resource.data.owins is int && request.resource.data.owins >= 0
        && request.resource.data.owins - resource.data.owins <= 5;
      allow delete: if false;
    }

    // People waiting for a quick match. Only the owner writes their own entry.
    match /lobby/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Rooms are only used for the first hello between two phones, then deleted.
    match /rooms/{room} {
      allow read, write: if request.auth != null;
      match /ice/{doc} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
